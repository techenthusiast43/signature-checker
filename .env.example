# ===================================================================
# SignatureCheck — Environment Configuration Template
# ===================================================================

# 1. Reown AppKit Project ID (WalletConnect)
# Get a project ID at: https://cloud.reown.com
VITE_REOWN_PROJECT_ID=your_reown_project_id_here

# 2. Deployer Private Key for Smart Contract Deployment
# Used by `scripts/deploy.js` to deploy SignatureRegistry on BOT Chain
# Note: Never share or commit this key to public repositories
PRIVATE_KEY=your_private_key_here

# 3. Target Deployment Network: "testnet" (Bohr - 968) or "mainnet" (BOT Chain - 677)
NETWORK=testnet

# 4. Optional Custom RPC URL (leave blank to use official default endpoints)
# Testnet default: https://rpc.bohr.life
# Mainnet default: https://rpc.botchain.ai
# RPC_URL=https://rpc.bohr.life

